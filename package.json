{
  "name": "tetris",
  "private": true,
  "version": "0.1.0",
  "description": "Tetris - web-only end-to-end encrypted messenger with 24h expiry and a vault passcode",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tetris/web",
    "dev:api": "npm run dev -w @tetris/api",
    "build": "npm run build -w @tetris/web",
    "deploy": "npm run build && npm run deploy -w @tetris/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "tsx scripts/e2e.ts",
    "users:seed": "tsx scripts/seed-users.ts",
    "groups:seed": "tsx scripts/seed-groups.ts",
    "db:migrate:local": "npm run db:migrate:local -w @tetris/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @tetris/api"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=20"
  }
}
