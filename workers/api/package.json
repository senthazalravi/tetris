{
  "name": "@lop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../../apps/web/dist',{recursive:true})\" && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply lop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lop-db --remote"
  },
  "dependencies": {
    "@lop/config": "*",
    "@lop/types": "*",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250917.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.0"
  }
}
