{
  "name": "@lop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply lop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lop-db --remote",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@lop/config": "*",
    "@lop/types": "*",
    "@noble/hashes": "^1.8.0",
    "hono": "^4.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250917.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.0"
  }
}
